{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ListMaster",
  "version": "0.1.0",
  "identifier": "de.listmaster.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ListMaster",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5QkI3QTEzOUJGQ0M3MUQKUldRZHgveWJFM3E3Q1FPcGNyZXB5Nk52alVuYW9OZW43WndQWk0ycWJVajV5T2FncmJrcHBPcGMK",
      "endpoints": [
        "https://github.com/pesse/listMaster/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
